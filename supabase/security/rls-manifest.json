{
  "_comment": [
    "Expected RLS state, checked by scripts/check-rls-policies.js (rules: scripts/rls-policy-check/rules.js).",
    "protected: exact policies + anon/authenticated grants + required guard triggers. Change only together with the migration that changes them.",
    "baseline: known ratchet findings per environment as of 2026-10-01. New findings fail; remove entries as they are fixed.",
    "Regenerate a protected table's block after a reviewed migration: node scripts/check-rls-policies.js --env staging --print-protected"
  ],
  "sensitive_columns": [
    "status",
    "accepted_by",
    "accepted_request_id",
    "winner",
    "resolved_by",
    "resolution",
    "amount",
    "balance",
    "balance_on_hold",
    "account_status",
    "role"
  ],
  "guarded_tables": {
    "bounties": "trg_bounties_guard_lifecycle",
    "bounty_disputes": "trg_bounty_disputes_guard",
    "profiles": "trg_prevent_client_writes_to_protected_profile_columns"
  },
  "protected": {
    "bounties": {
      "policies": [
        {
          "policyname": "bounties_delete_owner",
          "cmd": "DELETE",
          "permissive": "PERMISSIVE",
          "roles": [
            "authenticated"
          ],
          "qual": "(poster_id = ( SELECT auth.uid() AS uid))",
          "with_check": null
        },
        {
          "policyname": "bounties_insert_active_owner",
          "cmd": "INSERT",
          "permissive": "PERMISSIVE",
          "roles": [
            "authenticated"
          ],
          "qual": null,
          "with_check": "((poster_id = ( SELECT auth.uid() AS uid)) AND ((user_id IS NULL) OR (user_id = ( SELECT auth.uid() AS uid))) AND is_account_active(( SELECT auth.uid() AS uid)))"
        },
        {
          "policyname": "bounties_select_authenticated",
          "cmd": "SELECT",
          "permissive": "PERMISSIVE",
          "roles": [
            "authenticated"
          ],
          "qual": "true",
          "with_check": null
        },
        {
          "policyname": "bounties_update_owner",
          "cmd": "UPDATE",
          "permissive": "PERMISSIVE",
          "roles": [
            "authenticated"
          ],
          "qual": "(poster_id = ( SELECT auth.uid() AS uid))",
          "with_check": "(poster_id = ( SELECT auth.uid() AS uid))"
        }
      ],
      "grants": {
        "anon": [],
        "authenticated": [
          "DELETE",
          "INSERT",
          "SELECT",
          "UPDATE"
        ]
      },
      "required_triggers": [
        "trg_bounties_guard_lifecycle",
        "trg_bounties_enforce_funding_before_work"
      ]
    },
    "bounty_disputes": {
      "policies": [
        {
          "policyname": "bounty_disputes_insert_participant",
          "cmd": "INSERT",
          "permissive": "PERMISSIVE",
          "roles": [
            "authenticated"
          ],
          "qual": null,
          "with_check": "((initiator_id = ( SELECT auth.uid() AS uid)) AND ((status)::text = 'open'::text) AND (winner IS NULL) AND (resolution IS NULL) AND (resolved_by IS NULL) AND (resolved_at IS NULL) AND (COALESCE(hold_amount, (0)::numeric) = (0)::numeric) AND (COALESCE(escalated, false) = false) AND (stripe_dispute_id IS NULL) AND (EXISTS ( SELECT 1\n   FROM bounties b\n  WHERE ((b.id = bounty_disputes.bounty_id) AND (b.accepted_by IS NOT NULL) AND ((b.status)::text = ANY (ARRAY['in_progress'::text, 'cancellation_requested'::text])) AND (((( SELECT auth.uid() AS uid) = b.poster_id) OR (( SELECT auth.uid() AS uid) = b.user_id)) OR (( SELECT auth.uid() AS uid) = b.accepted_by)) AND ((bounty_disputes.respondent_id IS NULL) OR (((bounty_disputes.respondent_id = b.poster_id) OR (bounty_disputes.respondent_id = b.user_id)) OR (bounty_disputes.respondent_id = b.accepted_by)))))))"
        },
        {
          "policyname": "bounty_disputes_select_participant_or_admin",
          "cmd": "SELECT",
          "permissive": "PERMISSIVE",
          "roles": [
            "authenticated"
          ],
          "qual": "((COALESCE(((auth.jwt() -> 'app_metadata'::text) ->> 'role'::text), ''::text) = 'admin'::text) OR (EXISTS ( SELECT 1\n   FROM bounties b\n  WHERE ((b.id = bounty_disputes.bounty_id) AND ((b.poster_id = ( SELECT auth.uid() AS uid)) OR (b.user_id = ( SELECT auth.uid() AS uid)) OR (b.accepted_by = ( SELECT auth.uid() AS uid)))))))",
          "with_check": null
        },
        {
          "policyname": "bounty_disputes_update_admin",
          "cmd": "UPDATE",
          "permissive": "PERMISSIVE",
          "roles": [
            "authenticated"
          ],
          "qual": "(COALESCE(((auth.jwt() -> 'app_metadata'::text) ->> 'role'::text), ''::text) = 'admin'::text)",
          "with_check": "(COALESCE(((auth.jwt() -> 'app_metadata'::text) ->> 'role'::text), ''::text) = 'admin'::text)"
        }
      ],
      "grants": {
        "anon": [],
        "authenticated": [
          "INSERT",
          "SELECT",
          "UPDATE"
        ]
      },
      "required_triggers": [
        "trg_bounty_disputes_guard"
      ]
    },
    "ratings": {
      "policies": [
        {
          "policyname": "ratings_insert_transaction_party",
          "cmd": "INSERT",
          "permissive": "PERMISSIVE",
          "roles": [
            "authenticated"
          ],
          "qual": null,
          "with_check": "((from_user_id = ( SELECT auth.uid() AS uid)) AND (bounty_id IS NOT NULL) AND (rating >= (1)::numeric) AND (rating <= (5)::numeric) AND (EXISTS ( SELECT 1\n   FROM bounties b\n  WHERE ((b.id = ratings.bounty_id) AND (b.accepted_by IS NOT NULL) AND (((b.status)::text = 'completed'::text) OR (((b.status)::text = 'archived'::text) AND (EXISTS ( SELECT 1\n           FROM completion_submissions cs\n          WHERE ((cs.bounty_id = b.id) AND (cs.status = 'approved'::text)))))) AND (((ratings.from_user_id = COALESCE(b.poster_id, b.user_id)) AND (ratings.to_user_id = b.accepted_by)) OR ((ratings.from_user_id = b.accepted_by) AND (ratings.to_user_id = COALESCE(b.poster_id, b.user_id))))))))"
        },
        {
          "policyname": "ratings_select_all",
          "cmd": "SELECT",
          "permissive": "PERMISSIVE",
          "roles": [
            "public"
          ],
          "qual": "true",
          "with_check": null
        }
      ],
      "grants": {
        "anon": [
          "SELECT"
        ],
        "authenticated": [
          "INSERT",
          "SELECT"
        ]
      }
    },
    "dispute_audit_log": {
      "policies": [
        {
          "policyname": "dispute_audit_log_insert_participant_or_admin",
          "cmd": "INSERT",
          "permissive": "PERMISSIVE",
          "roles": [
            "authenticated"
          ],
          "qual": null,
          "with_check": "((COALESCE(((auth.jwt() -> 'app_metadata'::text) ->> 'role'::text), ''::text) = 'admin'::text) OR (EXISTS ( SELECT 1\n   FROM (bounty_disputes d\n     JOIN bounties b ON ((b.id = d.bounty_id)))\n  WHERE ((d.id = dispute_audit_log.dispute_id) AND (((( SELECT auth.uid() AS uid) = b.poster_id) OR (( SELECT auth.uid() AS uid) = b.user_id)) OR (( SELECT auth.uid() AS uid) = b.accepted_by))))))"
        },
        {
          "policyname": "dispute_audit_log_select_admin",
          "cmd": "SELECT",
          "permissive": "PERMISSIVE",
          "roles": [
            "authenticated"
          ],
          "qual": "(COALESCE(((auth.jwt() -> 'app_metadata'::text) ->> 'role'::text), ''::text) = 'admin'::text)",
          "with_check": null
        }
      ],
      "grants": {
        "anon": [],
        "authenticated": [
          "INSERT",
          "SELECT"
        ]
      }
    },
    "bounty_cancellations": {
      "commands": [
        "UPDATE"
      ],
      "policies": [
        {
          "policyname": "bounty_cancellations_update_responder",
          "cmd": "UPDATE",
          "permissive": "PERMISSIVE",
          "roles": [
            "authenticated"
          ],
          "qual": "((( SELECT auth.uid() AS uid) IS NOT NULL) AND (( SELECT auth.uid() AS uid) <> requester_id) AND (EXISTS ( SELECT 1\n   FROM bounties b\n  WHERE ((b.id = bounty_cancellations.bounty_id) AND ((( SELECT auth.uid() AS uid) = b.poster_id) OR (( SELECT auth.uid() AS uid) = b.accepted_by))))))",
          "with_check": "((( SELECT auth.uid() AS uid) <> requester_id) AND ((responder_id IS NULL) OR (responder_id = ( SELECT auth.uid() AS uid))) AND (EXISTS ( SELECT 1\n   FROM bounties b\n  WHERE ((b.id = bounty_cancellations.bounty_id) AND ((( SELECT auth.uid() AS uid) = b.poster_id) OR (( SELECT auth.uid() AS uid) = b.accepted_by))))))"
        }
      ],
      "grants": {
        "anon": [],
        "authenticated": [
          "INSERT",
          "SELECT"
        ]
      }
    }
  },
